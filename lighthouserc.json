{
  "ci": {
    "collect": {
      "staticDistDir": "build/client",
      "url": [
        "http://localhost/",
        "http://localhost/aessbot",
        "http://localhost/cursos",
        "http://localhost/projectes",
        "http://localhost/uneix-te",
        "http://localhost/contacte"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
